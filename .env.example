# Lu seulement au PREMIER démarrage : ensuite les serveurs se gèrent depuis le site (Admin → Serveurs surveillés).
# Plusieurs serveurs séparés par ";" : Nom|ip:port[|url_ftp_du_log];Autre|ip:port
# Logs : ajouter un 3e champ = dossier FTP du mod contenant qconsole.log, games_mp.log et enterleave.log
#   (caractères spéciaux du mot de passe à encoder : @ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25)
# Commandes depuis la page : 4e champ = rcon_password du serveur (dans son server.cfg)
#   ex : Mon Serveur|203.0.113.10:55555|ftp://user:pass@203.0.113.10:21/mods/mon_mod/|motdepasse_rcon
SERVERS=Mon Serveur|203.0.113.10:55555
POLL_INTERVAL=5s
QUERY_TIMEOUT=2s
# Fréquence de relecture du log par FTP
LOG_POLL_INTERVAL=2s
# Fuseau horaire de l'horloge du serveur de jeu (dates de enterleave.log)
SERVER_LOG_TZ=UTC
# Durée sans réponse avant de déclarer le serveur hors ligne (un changement de map ne répond pas ~20-40 s)
OFFLINE_AFTER=45s
# Compte admin du dashboard : identifiant ET mot de passe obligatoires dès que la page est accessible depuis le réseau ou internet.
# Mot de passe vide = aucune connexion demandée (usage sur le PC seulement).
DASHBOARD_USER=
DASHBOARD_PASSWORD=
HTTP_PORT=8080
DB_PATH=/data/monitor.db
RETENTION_DAYS=90
# Sauvegarde quotidienne de la base (dossier ./backups du projet), nombre de jours gardés
BACKUP_DIR=/backups
BACKUP_KEEP=14
DISCORD_WEBHOOK_URL=
# Alerte Discord quand le nombre de joueurs atteint ce seuil (0 = désactivé)
DISCORD_PLAYER_THRESHOLD=0
TZ=Europe/Paris

# Hébergement (docker-compose.prod.yml) : adresse publique du dashboard, ex. mon-serveur.duckdns.org
DOMAIN=

# Mails (optionnel, voir README) : alertes du VPS, résumé de la semaine, alertes de joueurs. SMTP_HOST vide = aucun mail.
#   Gmail : smtp.gmail.com, port 587, mot de passe d'application (compte Google -> Sécurité -> Mots de passe des applications)
#   Resend : smtp.resend.com, port 465, SMTP_USER=resend, SMTP_PASSWORD=clé API re_..., MAIL_FROM=adresse de ton domaine vérifié (README)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Destinataire(s), séparés par des virgules
MAIL_TO=
MAIL_LANG=fr
# 0 = pas de résumé de la semaine (lundi 9 h)
WEEKLY_MAIL=
# Seuils d'alerte du VPS : disque et mémoire en %, charge processeur sur 15 min par cœur
VPS_DISK_ALERT=90
VPS_MEM_ALERT=90
VPS_LOAD_ALERT=2

# Serveur de jeu sur la même machine : logs lus sur le disque au lieu du FTP (README section 13).
# Dossier de la machine qui contient les logs (ou tout le serveur), monté en lecture seule par docker-compose.local-logs.yml.
LOCAL_LOGS_DIR=
# Sans Docker : dossier où le monitor a le droit de lire des logs (défaut /gamelogs/).
# LOCAL_LOGS_ROOT=/gamelogs/

# B3 (bot d'admin) du serveur de jeu sur la même machine : sa base lue et modifiée par le dashboard (README section 14).
# Dossier de B3 qui contient b3.db, monté en lecture/écriture par docker-compose.b3.yml sur /b3/.
B3_DATA_DIR=
# Sans Docker : dossier où le monitor a le droit d'ouvrir une base B3 (défaut /b3/).
# B3_ROOT=/b3/

# Proxys autorisés à transmettre X-Forwarded-For et X-Forwarded-Proto.
# N'indiquer que les adresses exactes du reverse proxy. Docker production configure Caddy automatiquement.
# Mettre TRUSTED_PROXIES=none pour ignorer tous les en-têtes proxy.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Adresse d'écoute. Sans mot de passe dashboard, 127.0.0.1 est imposé.
HTTP_BIND=
# Optionnel : clé AES-256 en base64. Sinon génération automatique de DB_PATH.key (permissions 0600).
# Conserver cette clé séparément et la restaurer avec la base ; ne pas la changer arbitrairement.
# MONITOR_SECRET_KEY=
