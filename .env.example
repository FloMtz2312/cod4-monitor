# Settings of CoD4 Monitor. Every variable is explained in README.md (section 5) · README.fr.md · README.de.md
# Read only at the FIRST start: after that, the servers are managed from the site (More → All servers).
# Several servers separated by ";": Name|ip:port[|log_ftp_url];Other|ip:port
# Logs: add a 3rd field = FTP folder of the mod that contains qconsole.log, games_mp.log and enterleave.log
#   (special characters in the password must be encoded: @ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25)
# Commands from the page: 4th field = the server's rcon_password (in its server.cfg)
#   e.g. My Server|203.0.113.10:55555|ftp://user:pass@203.0.113.10:21/mods/my_mod/|myrcon
SERVERS=My Server|203.0.113.10:55555
# How often the server is queried (5 s minimum; 15s if the line is missing)
POLL_INTERVAL=5s
QUERY_TIMEOUT=2s
# How often the log is read again over FTP
LOG_POLL_INTERVAL=2s
# FTP connection renewed after this long (some FTP servers only show new lines to a new connection; 0 = never)
# LOG_FTP_SESSION=60s
# Past of games_mp.log imported over FTP on first start only below this size in MB (0 = never over FTP)
# HISTORY_FTP_MAX_MB=50
# Biggest old log file accepted by the import of the server settings, in MB
# IMPORT_MAX_MB=2048
# Time zone of the game server's clock (dates in enterleave.log)
SERVER_LOG_TZ=UTC
# Time without an answer before the server is marked offline (a map change doesn't answer for ~20-40 s)
OFFLINE_AFTER=45s
# Super admin account of the dashboard: username AND password required with Docker, even on a PC
# (without a password, the monitor only listens on 127.0.0.1 inside the container: the port published by Docker can't reach it).
# Empty password = no login at all: only when running the binary directly (go run ./cmd/monitor),
# and the site then only answers from the PC itself.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
HTTP_PORT=8080
DB_PATH=/data/monitor.db
RETENTION_DAYS=90
# Daily backup of the database (the project's ./backups folder), number of days kept
BACKUP_DIR=/backups
BACKUP_KEEP=14
DISCORD_WEBHOOK_URL=
# Discord alert when the number of players reaches this threshold (0 = off)
DISCORD_PLAYER_THRESHOLD=0
TZ=Europe/Paris

# Hosting (docker-compose.prod.yml): public address of the dashboard, e.g. my-server.duckdns.org
DOMAIN=

# Mails (optional, see README): VPS alerts, weekly summary, player alerts. Empty SMTP_HOST = no mail.
#   Gmail: smtp.gmail.com, port 587, app password (Google account -> Security -> App passwords)
#   Resend: smtp.resend.com, port 465, SMTP_USER=resend, SMTP_PASSWORD=API key re_..., MAIL_FROM=an address on your verified domain (README)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Recipient(s), separated by commas
MAIL_TO=
MAIL_LANG=fr
# 0 = no weekly summary (Monday 9 am)
WEEKLY_MAIL=
# VPS alert thresholds: disk and memory in %, 15-min CPU load per core
VPS_DISK_ALERT=90
VPS_MEM_ALERT=90
VPS_LOAD_ALERT=2

# Game server on the same machine: logs read from the disk instead of FTP (README section 13).
# Folder of the machine that contains the logs (or the whole server), mounted read-only by docker-compose.local-logs.yml.
LOCAL_LOGS_DIR=
# Without Docker: folder the monitor is allowed to read logs from (default /gamelogs/).
# LOCAL_LOGS_ROOT=/gamelogs/

# B3 (admin bot) of the game server on the same machine: its database read and edited by the dashboard (README section 14).
# B3 folder that contains b3.db, mounted read/write by docker-compose.b3.yml on /b3/.
B3_DATA_DIR=
# Without Docker: folder the monitor is allowed to open a B3 database from (default /b3/).
# B3_ROOT=/b3/

# Proxies allowed to pass on X-Forwarded-For and X-Forwarded-Proto.
# Only list the exact addresses of the reverse proxy. Production Docker sets up Caddy automatically.
# Set TRUSTED_PROXIES=none to ignore all proxy headers.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Listen address. Without a dashboard password, 127.0.0.1 is enforced.
HTTP_BIND=
# Optional: AES-256 key in base64. Otherwise DB_PATH.key is generated automatically (0600 permissions).
# Keep this key separately and restore it with the database; don't change it arbitrarily.
# MONITOR_SECRET_KEY=
